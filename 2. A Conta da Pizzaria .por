programa {
  funcao inicio() {
    inteiro  amigos, conversao
    real  valorTotal

    escreva ("Digite a quantidade de pessoas:")
  leia(amigos)

  escreva ("Digite o valor em R$:")
  leia(valorTotal)

  conversao = valorTotal / amigos

  escreva("valorTotal vai ser de R$", conversao, " reais")
  }
}
