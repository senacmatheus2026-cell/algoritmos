programa {
  funcao inicio() {
    real kilometros, litros, mediaConsumo
    
    escreva("Digite os kilometros percorrido:")
    leia(kilometros)

    escreva("Digite os litros gastos:")
    leia(litros)

    mediaConsumo = kilometros/litros

    escreva("media de consumo foi de ",mediaConsumo)
  }
}
