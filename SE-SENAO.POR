programa {
    funcao inicio () {
     inteiro idade
     escreva("Digite sua idade")
     leia(idade)

     se (idade> = 18){
        escreva("Acasso permitido.")
        escreva("bem-vindo ao sistema!)
        }senao{
            escreva("Acesso Negado")
             escreva("Menores Não permitidos")
        }
    }
}