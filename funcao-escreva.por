programa {
  funcao inicio() {
    cadeia nome
    inteiro pontos, idade

    nome = "Douglas"
    pontos = 1500
    idade = 16
    escreva("Olá, mundo! \n")
    escreva(nome, " tem ",idade, "anos de idade. \n")
    escreva(nome, " tem ",idade, " anos de idade, e cerca de ",pontos, " pontos na cartola em toda sua carreira profissional de futebol." )
  }
}
