programa {
  funcao inicio() {
    //Declaração da Variável (criando a "caixa")
    cadeia nomeUsuario

    //ENTRADA: capturando dados do usuario
    escreva("Digite seu nome:")
    leia(nomeUsuario)

    //SAiDA: exibindo o resultado
    escreva("olá",nomeUsuario,"!")
  }
}
